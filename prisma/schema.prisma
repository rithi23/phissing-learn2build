generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InteractionAction {
  LOGIN
  REGISTER
  PASSWORD_RESET
}

model ParticipantInteraction {
  id              String             @id @default(cuid())
  name            String?
  email           String?
  action          InteractionAction
  passwordEntered Boolean            @default(false)
  passwordLength  Int?
  sessionId       String
  createdAt       DateTime           @default(now())

  @@index([email])
  @@index([action])
  @@index([createdAt])
}

model EventRegistration {
  id             String   @id @default(cuid())
  eventName      String
  fullName       String
  email          String
  phone          String
  organization   String
  role           String
  experience     String?
  projectIdea    String?
  skills         String?
  heardFrom      String?
  dietaryNeeds   String?
  tshirtSize     String?
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}
